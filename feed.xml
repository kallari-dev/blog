---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang | replace: '_', '-' }}">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <id>{{ '/' | absolute_url }}</id>
  <link href="{{ page.url | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/>
  {% assign articles = site.articles | sort: 'date' | reverse %}<updated>{{ articles.first.date | default: site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.author.name | xml_escape }}</name></author>
  {% for post in articles limit: 20 %}
  <entry>
    <title type="html">{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ post.url | absolute_url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    {% if post.category %}<category term="{{ post.category | xml_escape }}"/>{% endif %}
    {% for tag in post.tags %}<category term="{{ tag | xml_escape }}"/>{% endfor %}
    {% if post.description %}<summary type="html">{{ post.description | xml_escape }}</summary>{% endif %}
    <content type="html" xml:base="{{ post.url | absolute_url }}">{% capture body %}{% include images.html html=post.content %}{% endcapture %}{% capture body %}{% include callouts.html html=body %}{% endcapture %}{{ body | xml_escape }}</content>
  </entry>
  {% endfor %}
</feed>
